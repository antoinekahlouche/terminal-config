{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "one-dark",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "low",
    "permissions": "autoaccept",
    "grouping": "auto",
    "tps": true
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "horizontal"
  },
  "prompt": {
    "paste": "full"
  },
  "terminal": {
    "copy": "manual"
  }
}
