git:
  paging:
    colorArg: always
    pager: >-
      delta --dark --paging=never --line-numbers --syntax-theme=TwoDark
      --plus-style='syntax "#28352e"'
      --plus-emph-style='syntax "#354b3b"'
      --minus-style='syntax "#3b2c30"'
      --minus-emph-style='syntax "#50363d"'

customCommands:
  - key: '<c-a>'
    context: files
    description: Generate a commit message with Codex
    prompts:
      - type: confirm
        title: Generate a commit message?
        body: Send staged changes to Codex. You can edit the message before committing.
      - type: input
        key: Message
        title: 'Review commit message (Enter commits, Esc cancels)'
        initialValue: >-
          {{ runCommand "sh -c 'sh \"$HOME/Library/Application Support/lazygit/codex-commit-message.sh\"'" }}
    command: 'git commit -m {{.Form.Message | quote}}'
    output: log
